<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SpreadsheetApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Електронні таблиці"
    BackgroundColor="Black">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#F2F2F2" />
            <Setter Property="BorderColor" Value="#3A3A3A" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,1,*,1,Auto">

        <FlexLayout Grid.Row="0" Wrap="Wrap" JustifyContent="Start" Margin="16,14,16,8">
            <Button Text="Нова" Command="{Binding NewCommand}" Margin="0,0,8,6" />
            <Button Text="Відкрити" Command="{Binding OpenCommand}" Margin="0,0,8,6" />
            <Button Text="Зберегти" Command="{Binding SaveCommand}" Margin="0,0,8,6" />
            <Button Text="+ Рядок" Command="{Binding AddRowCommand}" Margin="0,0,8,6" />
            <Button Text="− Рядок" Command="{Binding RemoveRowCommand}" Margin="0,0,8,6" />
            <Button Text="+ Стовпчик" Command="{Binding AddColumnCommand}" Margin="0,0,8,6" />
            <Button Text="− Стовпчик" Command="{Binding RemoveColumnCommand}" Margin="0,0,8,6" />
            <Button Text="{Binding ModeTitle}" Command="{Binding ToggleModeCommand}"
                    BackgroundColor="#F2F2F2" TextColor="Black" BorderColor="#F2F2F2" Margin="0,0,8,6" />
            <Button Text="Довідка" Command="{Binding ShowHelpCommand}" Margin="0,0,8,6" />
        </FlexLayout>

        <BoxView Grid.Row="1" Color="#1F1F1F" HeightRequest="1" />

        <ScrollView Grid.Row="2" Orientation="Both" Margin="16,16,16,8">
            <Grid x:Name="TableGrid" HorizontalOptions="Start" VerticalOptions="Start" />
        </ScrollView>

        <BoxView Grid.Row="3" Color="#1F1F1F" HeightRequest="1" />

        <Label Grid.Row="4" Text="{Binding StatusMessage}" LineBreakMode="WordWrap"
               TextColor="#8A8A8A" FontSize="12" Margin="16,10,16,12" />

    </Grid>
</ContentPage>
